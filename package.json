{
  "name": "windswordai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "review:manifest": "node scripts/create-review-manifest.mjs",
    "review:screenshots": "node scripts/capture-review.mjs",
    "security:fixtures": "node scripts/check-sensitive-fixtures.mjs",
    "review:responsive": "node scripts/responsive-audit.mjs",
    "brand:build": "node scripts/build-brand-assets.mjs",
    "gateway": "node gateway/server.ts",
    "build:local": "NEXT_PUBLIC_DEMO_MODE=false NEXT_PUBLIC_GATEWAY_SAME_ORIGIN=true next build",
    "start:local": "npm run build:local && node gateway/server.ts",
    "review:gateway": "node scripts/gateway-e2e.mjs",
    "fake-providers": "node scripts/fake-providers.mjs 9911"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.5",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2"
  }
}
