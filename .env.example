# WindSwordAI public-safe example configuration.
# Never commit real credentials or legal-document paths.

NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_BASE_PATH=

# Future provider settings (leave blank in source control)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
DATABASE_URL=
SESSION_SECRET=
ENCRYPTION_KEY=

# Gateway (PR 03). All optional; see docs/PR03_GATEWAY.md
# WINDSWORD_HOST=127.0.0.1
# WINDSWORD_PORT=8787
# WINDSWORD_GATEWAY_TOKEN=
# WINDSWORD_VAULT_KEY=
# WINDSWORD_STATE_DIR=.windsword
# WINDSWORD_ALLOWED_ORIGINS=http://localhost:3000
# WINDSWORD_APPROVED_FOR_PROTECTED=
# Account linking (OAuth) per provider, see docs/PR03B_ACCOUNT_LINKING.md
# WINDSWORD_PUBLIC_URL=
# WINDSWORD_OAUTH_GEMINI_CLIENT_ID=
# WINDSWORD_OAUTH_GEMINI_CLIENT_SECRET=
# WINDSWORD_OAUTH_GEMINI_SCOPES=

# Sign in with Google (PR 03C). The client ID is public. The client SECRET must only ever live in your
# private, git-ignored .env (or your host's Secrets / Environment Variables). Never commit it.
WINDSWORD_AUTH=off
WINDSWORD_GOOGLE_CLIENT_ID=
WINDSWORD_GOOGLE_CLIENT_SECRET=
WINDSWORD_AUTH_ALLOWED_EMAILS=
WINDSWORD_SESSION_TTL_HOURS=168
